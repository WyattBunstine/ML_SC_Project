{
    "index_path":      "database/datafiles/MP_Energy/MP_Energy_V4.pickle",
    "target_column":   "formation_energy_per_atom",
    "max_num_nbr":     14,
    "max_num_poly_nbr": 16,

    "atom_feat_len":   64,
    "edge_hidden_dim": 128,
    "n_conv":          3,
    "h_feat_len":      64,
    "n_hidden":        1,
    "task": "regression",
    "target_transform": "none",
    "edge_aggregation": "attention",
    "atom_pooling":    "set2set",
    "use_poly_edges":  true,
    "normalize_features": true,

    "SC_to_non_SC_ratio": "inf",

    "batch_size":      64,
    "num_workers":     0,
    "graph_cache_size": 65536,
    "val_ratio":       0.1,
    "test_ratio":      0.1,

    "optim":           "AdamW",
    "learning_rate":   0.001,
    "momentum":        0.9,
    "weight_decay":    0.00001,
    "lr_milestones":   [500, 800],
    "epochs":          100,

    "print_split":     10,
    "out_file":        "models/MPNN/mpnn_eform"
}
