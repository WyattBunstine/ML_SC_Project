{
  "models": "ORIG",
  "dataset_rd": "database/datafiles/MP_Energy",
  "atom_init": "../atom_init.json",
  "dataset": "MP_Energy_orig.pickle",
  "target_column": "formation_energy_per_atom",

  "batch_size": 128,
  "val_ratio": 0.1,
  "test_ratio": 0.1,

  "atom_feat_len": 64,
  "n_conv": 3,
  "h_feat_len": 128,
  "n_hidden": 1,

  "optim": "SGD",
  "learning_rate":   0.001,
  "momentum":        0.9,
  "weight_decay":    0.00001,
  "lr_milestones":   [200, 400],
  "epochs":          500,

  "out_file": "CNN/test_result",
  "print_split": 10
}
