{
    "index_path":      "database/datafiles/MP/SC_MP_V4.pickle",
    "max_num_nbr":     14,
    "max_num_poly_nbr": 64,

    "atom_feat_len":   128,
    "edge_hidden_dim": 128,
    "n_conv":          4,
    "h_feat_len":      128,
    "n_hidden":        1,
    "task": "regression",
    "target_transform": "log1p",
    "edge_aggregation": "attention",
    "atom_pooling":    "set2set",
    "use_poly_edges":  true,
    "normalize_features": true,
    "target_column": "tc",

    "SC_to_non_SC_ratio": "1.0",

    "batch_size":      64,
    "num_workers":     2,
    "graph_cache_size": 4096,
    "val_ratio":       0.1,
    "test_ratio":      0.1,

    "optim":           "AdamW",
    "learning_rate":   0.001,
    "momentum":        0.9,
    "weight_decay":    0.00001,
    "lr_milestones":   [500, 800],
    "epochs":          100,

    "print_split":     10,
    "out_file":        "CNN/MPNN/mpnn_result"
}
