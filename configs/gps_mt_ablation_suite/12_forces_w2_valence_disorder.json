{
  "architecture": "gps",
  "index_path": [
    "${ML_SC_DATA}/MPtrj/packed_v4",
    "${ML_SC_DATA}/MP/dos_pack_ef1",
    "${ML_SC_DATA}/MP/disorder_pack"
  ],
  "target_column": "formation_energy_per_atom",
  "max_num_nbr": 14,
  "max_num_poly_nbr": 64,
  "atom_feat_len": 128,
  "n_conv": 4,
  "h_feat_len": 128,
  "n_hidden": 2,
  "use_poly_edges": true,
  "atom_pooling": "mean",
  "set_transformer_heads": 8,
  "gps_global": false,
  "gps_global_heads": 8,
  "gps_ffn_mult": 2,
  "local_transformer": true,
  "per_atom_head": true,
  "use_bond_edges": true,
  "shell_aggregation": "attention",
  "use_angle_bias": true,
  "task": "regression",
  "target_transform": "none",
  "normalize_features": true,
  "split_by": "material",
  "split_seed": 123,
  "val_ratio": 0.05,
  "test_ratio": 0.05,
  "batch_size": 512,
  "size_grouped_batches": true,
  "max_atoms_per_batch": 4000,
  "size_pool_factor": 20,
  "frame_subsample": 3,
  "amp": false,
  "num_workers": 20,
  "prefetch_factor": 4,
  "optim": "AdamW",
  "learning_rate": 0.0003,
  "warmup_epochs": 3,
  "grad_clip": 0.5,
  "weight_decay": 1e-05,
  "lr_milestones": [
    40,
    80
  ],
  "epochs": 100,
  "print_split": 200,
  "out_file": "result_valence_disorder",
  "slurm": {
    "gpus": 4,
    "cpus": 48,
    "mem": "96G",
    "time": "72:00:00",
    "partition": "ica100,a100"
  },
  "run_tag": "gps_mt_12_valence_disorder",
  "tasks": [
    "energy",
    "forces",
    "stress",
    "magmom",
    "bandgap",
    "dos"
  ],
  "loss_weights": {
    "energy": 1.0,
    "forces": 2.0,
    "stress": 1.0,
    "magmom": 1.0,
    "bandgap": 1.0,
    "dos": 1.0
  },
  "n_energy": 128,
  "dos_per_atom": true,
  "use_valence_features": true
}